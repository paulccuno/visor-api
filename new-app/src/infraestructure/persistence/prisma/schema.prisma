generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lot {
  id String @id @default(uuid())

  block       String
  lot         Int
  area        Decimal @db.Decimal(10, 2)
  price_x_m2  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(10, 2)

  availability_status_id Int
  availability_status    MasterTable @relation("LotAvailabilityStatus", fields: [availability_status_id], references: [id])

  price_visibility Boolean @default(true)

  created_by    String    @db.VarChar(50)
  updated_by    String?   @db.VarChar(50)
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  record_status Boolean   @default(true)

  @@index([block, lot])
}

model User {
  id String @id @default(uuid())

  name String

  email     String @unique
  user_name String @unique
  password  String

  created_by    String    @db.VarChar(50)
  updated_by    String?   @db.VarChar(50)
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  record_status Boolean   @default(true)
}

model MasterTable {
  id Int @id @default(autoincrement())

  parent_id   Int?
  name        String
  description String
  value       String

  created_by    String    @db.VarChar(50)
  updated_by    String?   @db.VarChar(50)
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  record_status Boolean   @default(true)

  Lot_availability_status Lot[] @relation("LotAvailabilityStatus")
}
