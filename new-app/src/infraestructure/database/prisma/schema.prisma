generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lot {
  id String @id @default(uuid())

  block      String
  lot        Int
  area       Decimal @db.Decimal(10, 2)
  pricePerm2 Decimal @map("price_x_m2") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)

  availabilityStatusId Int         @map("availability_status_id")
  availabilityStatus   MasterTable @relation("LotAvailabilityStatus", fields: [availabilityStatusId], references: [id])

  priceVisibility Boolean @default(true) @map("price_visibility")

  createdBy    String    @map("created_by") @db.VarChar(50)
  updatedBy    String?   @map("updated_by") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  recordStatus Boolean   @default(true) @map("record_status")

  @@index([block, lot])
}

model User {
  id String @id @default(uuid())

  name String

  email    String @unique
  username String @unique
  password String

  createdBy    String    @map("created_by") @db.VarChar(50)
  updatedBy    String?   @map("updated_by") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  recordStatus Boolean   @default(true) @map("record_status")
}

model MasterTable {
  id Int @id @default(autoincrement())

  parentId    Int?   @map("parent_id")
  name        String
  description String
  value       String

  createdBy    String    @map("created_by") @db.VarChar(50)
  updatedBy    String?   @map("updated_by") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  recordStatus Boolean   @default(true) @map("record_status")

  LotAvailabilityStatus Lot[] @relation("LotAvailabilityStatus")
}
